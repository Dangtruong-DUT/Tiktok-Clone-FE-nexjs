# Dataset generation scripts (Gemini)
Gemini_Api_key="your_gemini_api_key_here"

# AI serve runtime
AI_LOG_LEVEL=INFO
AI_ENABLE_KAFKA=true
AI_STRICT_SEGMENT=false

# Model
AI_MODEL_NAME=vinai/phobert-base
AI_MODEL_PATH=models/best_phobert_model.pt
AI_MAX_LENGTH=256
AI_DEVICE=auto
AI_REVIEW_THRESHOLD=0.5
AI_VIOLATION_THRESHOLD=0.8

# API security (optional)
AI_MODERATION_API_KEY=

# Vietnamese segmentation
VNCORENLP_JAR_PATH=
VNCORENLP_MAX_HEAP_SIZE=-Xmx2g

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_MODERATION_REQUEST_TOPIC=moderation.request.v1
KAFKA_MODERATION_RESULT_TOPIC=moderation.result.v1
KAFKA_MODERATION_CONSUMER_GROUP=ai-moderator-v1

#huggingface
HF_TOKEN=your_huggingface_token_here
HF_HUB_DISABLE_PROGRESS_BARS=1
AI_SUPPRESS_HF_LOAD_LOGS=true