        <mxCell id="s2-arr-mw23" value="" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s2-mw2" target="s2-mw3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ISSUE: ARCH #1 - clearToken in URL -->
        <mxCell id="s2-issue3" value="🟣 ARCH #1: clearToken=true trong URL query param&#xa;→ Thông tin lộ qua browser history, server logs, referrer headers&#xa;→ ClearTokenByServer.tsx đọc ?clearToken để dispatch logout Redux&#xa;→ Fix: chỉ cần redirect /login, KHÔNG cần query param&#xa;📁 private-route.middleware.ts · clear-token-by-server.tsx"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9900ff;fontColor=#9900ff;fontSize=10;fontStyle=1;align=left;"
          vertex="1" parent="1">
