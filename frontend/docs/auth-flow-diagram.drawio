              <mxPoint x="370" y="422" />
              <mxPoint x="370" y="487" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 6: Browser Redux update -->
        <mxCell id="s1-b2" value="6. RTK Middleware:&#xa;setAuthenticated(true)&#xa;setRole(user.role)&#xa;setUserProfile(user)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="462" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ISSUE: MEDIUM #1 - tokens in JSON body -->
        <mxCell id="s1-issue2" value="🟠 MEDIUM #1: Tokens vẫn trả trong JSON response body!&#xa;→ JS code có thể đọc access_token và refresh_token từ response&#xa;→ Fix: Chỉ trả { user } trong JSON, KHÔNG trả tokens&#xa;📁 api/auth/login/route.ts:34 · api/auth/register/route.ts:34"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#ff6600;fontColor=#cc4400;fontSize=10;fontStyle=1;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1000" y="455" width="570" height="70" as="geometry" />
        </mxCell>

