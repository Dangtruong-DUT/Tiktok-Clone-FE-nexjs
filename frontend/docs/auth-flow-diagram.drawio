        <!-- Step: Middleware reads tokens -->
        <mxCell id="s2-mw1" value="Middleware:&#xa;reads cookies: access_token, refresh_token&#xa;isAuthenticated = !!refresh_token"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="260" y="600" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- ISSUE: MEDIUM #2 - no expiry check -->
        <mxCell id="s2-issue1" value="🟠 MEDIUM #2: isAuthenticated = !!refresh_token — chỉ check sự tồn tại!&#xa;→ refresh_token đã EXPIRED vẫn bị coi là &quot;đã đăng nhập&quot;&#xa;→ User sẽ bị redirected về /refresh-token liên tục nếu access expired&#xa;📁 src/middleware.ts:15 · src/middlewares/auth.middleware.ts:18"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#ff6600;fontColor=#cc4400;fontSize=10;fontStyle=1;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1000" y="595" width="570" height="75" as="geometry" />
        </mxCell>
