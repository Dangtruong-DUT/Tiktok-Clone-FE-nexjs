        <!-- FLOW 2: MIDDLEWARE AUTH CHECK (y: 570–970) -->
        <!-- ============================================================ -->
        <mxCell id="s2-hdr" value="📌 FLOW 2: NEXT.JS MIDDLEWARE — Auth Check (chạy trước MỌI request)"
