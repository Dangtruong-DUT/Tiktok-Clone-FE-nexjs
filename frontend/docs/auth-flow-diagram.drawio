        <!-- Step: Laravel returns user -->
        <mxCell id="s5-lv1" value="Laravel trả user data&#xa;→ 200 { user }"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="760" y="1597" width="200" height="45" as="geometry" />
        </mxCell>

        <!-- Arrow: back to browser -->
        <mxCell id="s5-arr2" value="{ user } → Redux hydrate"
          style="rounded=0;fontSize=10;fontStyle=2;strokeColor=#333333;startArrow=none;endArrow=open;endFill=1;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="1648" as="sourcePoint" />
            <mxPoint x="220" y="1648" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ISSUE: ARCH #2 - hydration depends on /me working (which also fails) -->
        <mxCell id="s5-issue1" value="🟠 MEDIUM #4: AppProvider gọi useGetMeQuery → /api/v1/users/me trực tiếp tới Laravel&#xa;→ Cùng vấn đề FLOW 3: cookies không gửi được → /me cũng trả 401&#xa;→ isAuthenticated=false dù user đã login → UI hiện sai trạng thái&#xa;→ Fix: cùng fix với CRITICAL #3 (cookie bridge hoặc BFF proxy)&#xa;📁 src/provider/app-provider.tsx · src/store/services/user.service.ts"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#ff6600;fontColor=#cc4400;fontSize=10;fontStyle=1;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1000" y="1590" width="570" height="90" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- SUMMARY TABLE (y: 1730+) -->
        <!-- ============================================================ -->
        <mxCell id="sum-hdr" value="📋 TỔNG KẾT VẤN ĐỀ &amp; ĐỘ ƯU TIÊN FIX"
          style="text;html=1;strokeColor=#333333;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="1720" width="1570" height="30" as="geometry" />
        </mxCell>

        <mxCell id="sum-critical" value="🔴 CRITICAL — Fix ngay (security risk hoặc broken flow):&#xa;&#xa;#1  jwt.decode() KHÔNG verify → tokens giả mạo → expiry sai&#xa;     📁 jwt.util.ts | login/route.ts | register/route.ts | refresh-token/route.ts&#xa;&#xa;#2  Middleware dùng decoded JWT không verify để check role/banned → bypass admin auth!&#xa;     📁 role-check.middleware.ts | banned-user.middleware.ts | guest-route.middleware.ts&#xa;&#xa;#3  httpOnly cookies từ Next.js KHÔNG gửi tới Laravel + Laravel chưa có cookie bridge&#xa;     → Mọi API call có auth bị 401 → auto logout! (BROKEN FLOW)&#xa;     📁 store/services/client.ts | cần fix Laravel backend (Phase 0)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0e0;strokeColor=#cc0000;fontColor=#cc0000;fontSize=11;fontStyle=0;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="1762" width="760" height="185" as="geometry" />
        </mxCell>

        <mxCell id="sum-medium" value="🟠 MEDIUM — Fix sớm (design issue / UX bug):&#xa;&#xa;#1  Tokens vẫn trả trong JSON response body → JS đọc được&#xa;     📁 api/auth/login/route.ts:34 | api/auth/register/route.ts:34&#xa;&#xa;#2  isAuthenticated = !!refresh_token — không check expiry&#xa;     📁 src/middleware.ts:15 | auth.middleware.ts:18&#xa;&#xa;#3  MAX_REFRESH_RETRIES=2 quá thấp → transient error → auto logout&#xa;     📁 store/services/client.ts:17&#xa;&#xa;#4  AppProvider /users/me bị ảnh hưởng bởi CRITICAL #3 → UI trạng thái sai&#xa;     📁 src/provider/app-provider.tsx"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#ff6600;fontColor=#cc4400;fontSize=11;fontStyle=0;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="800" y="1762" width="760" height="185" as="geometry" />
        </mxCell>

        <mxCell id="sum-arch" value="🟣 ARCHITECTURE — Cần refactor (từ fix plan):&#xa;&#xa;#1  clearToken=true trong URL query param&#xa;     📁 private-route.middleware.ts | clear-token-by-server.tsx&#xa;&#xa;#2  Hai sources of truth: cookie (server) vs Redux (client)&#xa;     → Phase 1: dùng /me để hydrate, không decode token ở client&#xa;&#xa;#3  Role/banned check ở Next.js middleware (không có authority)&#xa;     → Enforce ở Laravel, Next.js middleware chỉ check sự tồn tại cookie"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9900ff;fontColor=#9900ff;fontSize=11;fontStyle=0;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="1960" width="760" height="150" as="geometry" />
        </mxCell>

        <mxCell id="sum-good" value="✅ ĐÃ LÀM ĐÚNG (không cần thay đổi):&#xa;&#xa;✅  Tokens được set vào httpOnly cookies (không localStorage)&#xa;✅  SameSite=Lax, Secure=true, Path=/ — cấu hình đúng&#xa;✅  Auth/register/refresh/logout đều đi qua Next.js BFF (đúng pattern)&#xa;✅  Mutex trong baseQueryWithReauth — tránh race condition khi refresh&#xa;✅  Redux authMiddleware handle login/logout/register/me responses&#xa;✅  Logout đúng: delete cookie server-side + revoke ở Laravel"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#005500;fontSize=11;fontStyle=0;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="800" y="1960" width="760" height="150" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
