        <!-- ============================================================ -->
        <!-- FLOW 3: AUTHENTICATED API CALL (y: 920–1360) -->
        <!-- ============================================================ -->
        <mxCell id="s3-hdr" value="📌 FLOW 3: API CALL CÓ XÁC THỰC — Browser gọi trực tiếp Laravel (baseQueryWithReauth)"
          style="text;html=1;strokeColor=#555555;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="910" width="780" height="28" as="geometry" />
        </mxCell>

        <!-- Step: Component makes call -->
        <mxCell id="s3-b1" value="React component cần data&#xa;→ RTK Query hook&#xa;(baseQueryWithReauth)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="952" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Arrow: Browser → Laravel DIRECT (cross-origin issue) -->
        <mxCell id="s3-arr-direct" value="GET {NEXT_PUBLIC_API_ENDPOINT}/posts (ví dụ)&#xa;credentials:&#39;include&#39; | KHÔNG có Authorization header!"
          style="rounded=0;fontSize=10;fontStyle=2;strokeColor=#cc0000;fontColor=#cc0000;startArrow=none;endArrow=open;endFill=1;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="980" as="sourcePoint" />
            <mxPoint x="760" y="980" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step: Laravel receives (no valid auth) -->
        <mxCell id="s3-lv1" value="Laravel nhận request:&#xa;- Có cookie? → chỉ gửi nếu cùng origin&#xa;- Không có Authorization header&#xa;- CHƯA CÓ cookie bridge!&#xa;→ Trả 401 Unauthorized"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0e0;strokeColor=#cc0000;fontSize=11;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="760" y="952" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- ISSUE: CRITICAL #3 - No cookie bridge -->
        <mxCell id="s3-issue1" value="🔴 CRITICAL #3: Laravel CHƯA có cookie-to-bearer bridge!&#xa;→ API calls có auth SẼ FAIL với 401 Unauthorized&#xa;→ Trong dev (port khác): cookies KHÔNG được gửi (cross-origin)&#xa;→ Trong prod (Nginx same origin): cookies gửi được NHƯNG Laravel không dùng&#xa;→ Fix (Phase 0): Laravel đọc access_token từ cookie nếu không có Bearer header&#xa;📁 src/store/services/client.ts (BackendBaseQuery + baseQueryWithReauth)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0e0;strokeColor=#cc0000;fontColor=#cc0000;fontSize=10;fontStyle=1;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1000" y="942" width="570" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s3-arr-i1" value="" style="dashed=1;endArrow=open;endFill=0;strokeColor=#cc0000;" edge="1" source="s3-lv1" target="s3-issue1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: 401 back to browser -->
        <mxCell id="s3-arr-401" value="401 Unauthorized"
          style="rounded=0;fontSize=10;fontStyle=2;strokeColor=#cc0000;fontColor=#cc0000;startArrow=none;endArrow=open;endFill=1;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="1060" as="sourcePoint" />
            <mxPoint x="220" y="1060" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step: Refresh attempt -->
        <mxCell id="s3-b2" value="baseQueryWithReauth:&#xa;Nhận 401 → try refresh"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="1080" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: Browser → BFF refresh-token -->
        <mxCell id="s3-arr-refresh" value="POST /api/auth/refresh-token (BFF)"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;fontStyle=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="s3-b2" target="s3-bff1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="1105" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step: BFF refresh -->
        <mxCell id="s3-bff1" value="BFF đọc refresh_token cookie&#xa;→ POST Laravel /refresh-token&#xa;→ Nhận tokens mới&#xa;→ Set new httpOnly cookies"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#006EAF;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="500" y="1080" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Arrow: refresh success back to browser -->
        <mxCell id="s3-arr-ref-ok" value="200 OK (new cookies set)"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;fontStyle=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="s3-bff1" target="s3-b3" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="370" y="1115" />
              <mxPoint x="370" y="1200" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step: Retry - still fails -->
        <mxCell id="s3-b3" value="Retry original request...&#xa;→ VẪN BỊ 401! (cùng vấn đề)&#xa;Sau MAX_REFRESH_RETRIES=2:&#xa;→ POST /api/auth/logout&#xa;→ User bị ĐĂNG XUẤT!"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0e0;strokeColor=#cc0000;fontSize=11;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="1175" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- ISSUE: MEDIUM #3 - MAX_REFRESH_RETRIES too aggressive -->
        <mxCell id="s3-issue2" value="🟠 MEDIUM #3: MAX_REFRESH_RETRIES=2 quá ngắn&#xa;→ Transient errors (network fluke) → auto logout!&#xa;→ Sau 2 lần fail BẰNG BẤT KỲ LÝ DO gì → logout người dùng&#xa;📁 src/store/services/client.ts:17"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#ff6600;fontColor=#cc4400;fontSize=10;fontStyle=1;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1000" y="1165" width="570" height="65" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- FLOW 4: LOGOUT (y: 1320–1620) -->
        <!-- ============================================================ -->
        <mxCell id="s4-hdr" value="📌 FLOW 4: LOGOUT"
          style="text;html=1;strokeColor=#555555;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="1310" width="300" height="28" as="geometry" />
        </mxCell>

        <!-- Step: User clicks logout -->
        <mxCell id="s4-b1" value="User click nút Logout"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="1352" width="200" height="45" as="geometry" />
        </mxCell>

        <!-- Arrow: Browser → BFF logout -->
        <mxCell id="s4-arr1" value="POST /api/auth/logout (RTK Mutation)"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;fontStyle=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="s4-b1" target="s4-bff1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="1375" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step: BFF reads cookie and calls Laravel -->
        <mxCell id="s4-bff1" value="BFF: đọc access_token + refresh_token&#xa;từ cookie (server-side read)&#xa;→ Delete cookies&#xa;→ Gọi Laravel logout"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#006EAF;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="500" y="1352" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Arrow: BFF → Laravel logout -->
        <mxCell id="s4-arr2" value="POST /api/v1/auth/logout&#xa;Authorization: Bearer {access_token}&#xa;Body: { refresh_token }"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;fontStyle=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="s4-bff1" target="s4-lv1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step: Laravel invalidates -->
        <mxCell id="s4-lv1" value="Laravel revoke/blacklist tokens&#xa;→ 200 OK"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="760" y="1352" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: BFF → Browser (cleared) -->
        <mxCell id="s4-arr3" value="200 OK + Set-Cookie (empty, max-age=0)"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;fontStyle=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="s4-bff1" target="s4-b2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="370" y="1387" />
              <mxPoint x="370" y="1475" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step: Browser clears Redux -->
        <mxCell id="s4-b2" value="isLogoutMutationAction:&#xa;setLoggedOutAction()&#xa;→ isAuthenticated=false&#xa;→ role=null, user=null"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="1452" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- GOOD: logout flow -->
        <mxCell id="s4-good1" value="✅ Logout flow hoạt động đúng:&#xa;   - Cookies bị delete ở BFF (server-side)&#xa;   - Redux bị clear ở client&#xa;   - Tokens bị revoke ở Laravel"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#005500;fontSize=10;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1000" y="1347" width="380" height="75" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- FLOW 5: APP HYDRATION (AppProvider) -->
        <!-- ============================================================ -->
        <mxCell id="s5-hdr" value="📌 FLOW 5: APP HYDRATION — Khi load trang (AppProvider)"
          style="text;html=1;strokeColor=#555555;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="1555" width="650" height="28" as="geometry" />
        </mxCell>

        <!-- Step: App loads -->
        <mxCell id="s5-b1" value="App load / reload page"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="1597" width="200" height="45" as="geometry" />
        </mxCell>

        <!-- Arrow: Browser → Laravel /users/me -->
        <mxCell id="s5-arr1" value="GET /api/v1/users/me (nếu initialAuthenticated=true)"
          style="rounded=0;fontSize=10;fontStyle=2;strokeColor=#333333;startArrow=none;endArrow=open;endFill=1;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="1620" as="sourcePoint" />
            <mxPoint x="760" y="1620" as="targetPoint" />
