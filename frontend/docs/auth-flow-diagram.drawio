          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step: Middleware role/banned check -->
        <mxCell id="s2-mw2" value="Nếu isAuthenticated:&#xa;decodeJwt(refresh_token)&#xa;→ check .role (SUPER_ADMIN?)&#xa;→ check .banned?"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="260" y="700" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2-arr-mw12" value="" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s2-mw1" target="s2-mw2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ISSUE: CRITICAL #2 - unverified JWT for auth decisions -->
        <mxCell id="s2-issue2" value="🔴 CRITICAL #2: decodeJwt(refresh_token) KHÔNG verify signature!&#xa;→ Kẻ tấn công có thể tự tạo JWT với role=SUPER_ADMIN trong cookie&#xa;→ Middleware sẽ cho phép truy cập /admin mà không kiểm tra thực tế!&#xa;→ Role/banned phải được ENFORCE tại Laravel, không tại Next.js middleware&#xa;📁 role-check.middleware.ts · banned-user.middleware.ts · guest-route.middleware.ts"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0e0;strokeColor=#cc0000;fontColor=#cc0000;fontSize=10;fontStyle=1;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1000" y="695" width="570" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s2-arr-i2" value="" style="dashed=1;endArrow=open;endFill=0;strokeColor=#cc0000;" edge="1" source="s2-mw2" target="s2-issue2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step: clearToken redirect -->
        <mxCell id="s2-mw3" value="Nếu !isAuthenticated + private route:&#xa;redirect /login?clearToken=true&amp;redirect=..."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="260" y="810" width="200" height="55" as="geometry" />
