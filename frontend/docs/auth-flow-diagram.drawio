          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 3: Laravel validates -->
        <mxCell id="s1-lv1" value="3. Validate credentials&#xa;Generate JWT access + refresh"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="760" y="195" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: Laravel → BFF (response) -->
        <mxCell id="s1-arr3" value="{ access_token, refresh_token, user }"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;fontStyle=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="s1-lv1" target="s1-bff2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 4: BFF decodes JWT (CRITICAL) -->
        <mxCell id="s1-bff2" value="4. BFF: decodeJwt(access_token)&#xa;    decodeJwt(refresh_token)&#xa;→ lấy .exp để set cookie expires"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#006EAF;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="500" y="290" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- ISSUE: CRITICAL #1 -->
        <mxCell id="s1-issue1" value="🔴 CRITICAL #1: jwt.decode() KHÔNG verify signature!&#xa;→ Nếu token bị forge, .exp sai → cookie sai TTL&#xa;→ Cần: jwt.verify(token, LARAVEL_JWT_SECRET)&#xa;📁 jwt.util.ts · login/route.ts · register/route.ts · refresh-token/route.ts"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0e0;strokeColor=#cc0000;fontColor=#cc0000;fontSize=10;fontStyle=1;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1000" y="280" width="570" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s1-arr-i1" value="" style="dashed=1;endArrow=open;endFill=0;strokeColor=#cc0000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="s1-bff2" target="s1-issue1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 5: BFF sets httpOnly cookies -->
        <mxCell id="s1-bff3" value="5. Set httpOnly cookie:&#xa;   access_token (SameSite=Lax, Secure=true)&#xa;   refresh_token (SameSite=Lax, Secure=true)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#006EAF;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="500" y="390" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s1-arr-bff23" value="" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s1-bff2" target="s1-bff3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- GOOD note about httpOnly -->
        <mxCell id="s1-good1" value="✅ Cookies là httpOnly → JS không đọc được tokens&#xa;✅ SameSite=Lax, Secure=true → CSRF protection"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#005500;fontSize=10;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1000" y="390" width="380" height="48" as="geometry" />
        </mxCell>

        <!-- Arrow: BFF → Browser (response JSON) -->
        <mxCell id="s1-arr4" value="Response JSON (có tokens trong body!) + Set-Cookie"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;fontStyle=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="s1-bff3" target="s1-b2" parent="1">
