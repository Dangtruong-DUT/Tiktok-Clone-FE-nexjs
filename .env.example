# Root env for Docker Compose at repo root
# Used by: compose.dev.yaml, compose.prod.yaml
#
# How to use (Windows PowerShell):
#   Copy-Item .env.example .env
#
# Note:
# - Backend containers still load ./backend/.env
# - Frontend containers still load ./frontend/.env
# - Keep values in sync where applicable (DB_* / NEXT_PUBLIC_*)

# Compose project naming (affects volume & network names)
COMPOSE_PROJECT_NAME=tiktok_clone
CONTAINER_PREFIX=backend

# Backend ports
NGINX_PORT=9696
POSTGRES_PORT=5432

# Backend DB credentials (should match ./backend/.env)
DB_DATABASE=tiktok_clone
DB_USERNAME=root
DB_PASSWORD=tiktok_clone_password

# Backend build/dev options (optional)
DOCKER_ENV=development
UID=1000
GID=1000
XDEBUG_ENABLED=true
XDEBUG_MODE=develop,coverage,debug,profile
XDEBUG_HOST=host.docker.internal
XDEBUG_IDE_KEY=DOCKER
XDEBUG_LOG=/dev/stdout
XDEBUG_LOG_LEVEL=0

# Frontend build-time env (required for frontend production image build)
NEXT_PUBLIC_API_ENDPOINT=http://localhost:9696/api
NEXT_PUBLIC_URL=http://localhost:9696
NEXT_PUBLIC_GOOGLE_AUTHORIZED_REDIRECT_URI=http://localhost:9696/api/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
