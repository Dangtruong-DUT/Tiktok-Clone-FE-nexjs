# Root env for Docker Compose (infrastructure layer only)
# Used by: compose.dev.yaml, compose.prod.yaml
#

# Compose project naming (affects network/volume/container names)
COMPOSE_PROJECT_NAME=snapi
CONTAINER_PREFIX=snapi

# Pick env files for each service (supports independent environment setup)
BACKEND_ENV_FILE=./backend/.env
FRONTEND_ENV_FILE=./frontend/.env
AI_ENV_FILE=./ai/.env

# Stack profile
DOCKER_ENV=development
NEXT_APP_ENV=development

# Exposed ports
NGINX_BACKEND_PORT=9696
NGINX_FRONTEND_PORT=9697
NGINX_PORT=9696
POSTGRES_PORT=5432

# Database container credentials (compose layer)
POSTGRES_DB=snapi
POSTGRES_USER=root
POSTGRES_PASSWORD=snapi_password

# MinIO
MINIO_PORT=9000
MINIO_PORT_CONSOLE=9001
MINIO_ROOT_USER=minio_root_user
MINIO_ROOT_PASSWORD=minio_root_password

# MailCatcher
MAILCATCHER_WEB_PORT=1080
MAILCATCHER_SMTP_PORT=1025

# Redis
REDIS_PORT=6379

# Kafka
KAFKA_PORT=9092
KAFKA_UI_PORT=8087
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# AI moderation service
AI_SERVE_PORT=8001
AI_MODEL_NAME=vinai/phobert-base
AI_MODEL_PATH=training/best_phobert_model.pt
AI_MAX_LENGTH=256
AI_DEVICE=auto
AI_VIOLATION_THRESHOLD=0.8
AI_MODERATION_API_KEY=
VNCORENLP_JAR_PATH=
VNCORENLP_MAX_HEAP_SIZE=-Xmx2g

# Backend direct Kafka consume settings
AI_MODERATION_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
AI_MODERATION_KAFKA_RESULT_TOPIC=moderation.result.v1
AI_MODERATION_KAFKA_RESULT_GROUP_ID=snapi-ai-moderation-result-consumer
AI_MODERATION_KAFKA_BROKER_VERSION=3.6.0


# Nginx CORS template variable
CORS_ALLOW_ORIGIN=*

# Linux UID/GID mapping used by development containers
UID=1000
GID=1000

# Xdebug options for development php-fpm/workspace images
XDEBUG_ENABLED=true
XDEBUG_MODE=develop,coverage,debug,profile
XDEBUG_HOST=host.docker.internal
XDEBUG_IDE_KEY=DOCKER
XDEBUG_LOG=/dev/stdout
XDEBUG_LOG_LEVEL=0

# Frontend public values used by compose.prod.yaml build/runtime
FRONTEND_PUBLIC_API_ENDPOINT=http://localhost:9696/api
FRONTEND_PUBLIC_URL=http://localhost:9697
FRONTEND_PUBLIC_GOOGLE_AUTHORIZED_REDIRECT_URI=http://localhost:9696/api/auth/google/callback
FRONTEND_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
