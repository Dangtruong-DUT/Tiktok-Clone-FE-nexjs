# Laravel application configuration
APP_NAME='Snapi'
APP_ENV=local
APP_KEY=base64:V3OmHJW6UW4gLP6FK+xOfTHbNa3W06cdFBdNjJ8eTjk=
APP_DEBUG=true
APP_URL=http://localhost:9696
FRONTEND_URL=http://localhost:9696
AUTH_GUARD=api

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_SCHEDULE_TIMEZONE=Asia/Ho_Chi_Minh

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=snapi
DB_USERNAME=root
DB_PASSWORD=snapi_password
DB_TIMEZONE=Asia/Ho_Chi_Minh

# Docker Compose override notes:
# - DB_HOST should resolve to service name: postgres
# - REDIS_HOST should resolve to service name: redis

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailcatcher
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minio_root_user
AWS_SECRET_ACCESS_KEY=minio_root_password
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET="snapi"
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000

VITE_APP_NAME="${APP_NAME}"

#JWT configuration
JWT_SECRET=hello_world_secret_key_for_jwt

# auth configuration
RESET_PASSWORD_EXPIRATION_MINUTES=60
RESET_PASSWORD_TOKEN_LENGTH=64

VERIFY_EMAIL_EXPIRATION_MINUTES=60
VERIFY_EMAIL_TOKEN_LENGTH=64


# ADMIN ACCOUNT CONFIGURATION
SYSTEM_ADMIN_USER_NAME=admin
SYSTEM_ADMIN_PASSWORD=admin123
SYSTEM_ADMIN_EMAIL=admin.tiktok@localhost.com

# AI moderation integration
AI_MODERATION_ENABLED=true
AI_MODERATION_BASE_URL=http://ai-serve:8001
AI_MODERATION_TIMEOUT_SECONDS=3
AI_MODERATION_API_KEY=
AI_MODERATION_SYSTEM_ADMIN_ID=1
AI_MODERATION_APPEAL_WINDOW_DAYS=7
AI_MODERATION_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
AI_MODERATION_KAFKA_REQUEST_TOPIC=moderation.request.v1
AI_MODERATION_KAFKA_RESULT_TOPIC=moderation.result.v1
AI_MODERATION_KAFKA_RESULT_GROUP_ID=snapi-ai-moderation-result-consumer
AI_MODERATION_KAFKA_BROKER_VERSION=3.6.0
