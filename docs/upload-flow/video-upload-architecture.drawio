        <mxCell id="mon1" value="Laravel Logs (Monolog)&#xa;→ CloudWatch / ELK&#xa;All request lifecycle" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2850" y="1040" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="mon2" value="Redis Queue Metrics&#xa;→ Queue depth&#xa;→ Job processing rate&#xa;→ Failed jobs count" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2850" y="1120" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="mon3" value="FFmpeg Logs&#xa;→ Encoding duration&#xa;→ Error rates&#xa;→ Progress events" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2850" y="1205" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="mon4" value="S3 / Storage Metrics&#xa;→ Bucket size&#xa;→ Request latency&#xa;→ Error rates" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f0f0f0;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="3060" y="1040" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="mon5" value="CDN Metrics&#xa;→ Cache hit rate&#xa;→ Bandwidth used&#xa;→ Edge latency (p99)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="3060" y="1125" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="mon6" value="APM (e.g. Datadog)&#xa;→ API response time&#xa;→ Upload success rate&#xa;→ Encoding SLA" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="3060" y="1210" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="mon7" value="WebSocket / SSE Events&#xa;(VideoEncodingStatusUpdated)&#xa;→ Push progress to client&#xa;→ Broadcast via Redis" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2850" y="1300" width="400" height="55" as="geometry"/></mxCell>

