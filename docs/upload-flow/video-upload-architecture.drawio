        <mxCell id="sec8" value="Upload Session TTL&#xa;expires_at enforced&#xa;Cleanup on expiry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2590" y="1260" width="170" height="55" as="geometry"/></mxCell>

